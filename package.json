{
  "name": "subtract-component-from-circuit-json",
  "version": "0.0.1",
  "description": "Remove components from TSX or Circuit JSON while preserving safe net connectivity",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shibosoftwaredev/subtract-component-from-circuit-json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup-node lib/index.ts --format esm --dts --sourcemap --clean",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "prepack": "bun run build",
    "test": "bun test",
    "test:update-svg": "BUN_UPDATE_SNAPSHOTS=1 bun test tests/svg",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@tscircuit/core": "^0.0.1989",
    "circuit-json": "^0.0.504",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tscircuit/props": "^0.0.666",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.14",
    "bun-match-svg": "^0.0.16",
    "circuit-to-svg": "^0.0.430",
    "stack-svgs": "^0.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
